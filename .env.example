# Copy to .env.local (gitignored) and fill in what you need. Expo loads .env and .env.local
# automatically; restart with `npx expo start --clear` after changing them.

# --- Firebase (read by app.config.js) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Mock data: true = mocks, false = real backend ---
# Empty = default: the Firebase features use mocks while the FIREBASE_* values above are missing,
# and the real backend once they are set. Any mix works; mocked features never touch Firebase.
# Mock accounts: demo@booksquare.test, ana@booksquare.test, bruno@booksquare.test and
# carla@booksquare.test, all with password 123456 (see DummyData/MockData.ts).
EXPO_PUBLIC_MOCK_AUTH=
EXPO_PUBLIC_MOCK_USERS=
EXPO_PUBLIC_MOCK_BOOKS=
EXPO_PUBLIC_MOCK_CART=
EXPO_PUBLIC_MOCK_CHAT=
EXPO_PUBLIC_MOCK_TRANSACTIONS=
# Photo uploads (mocked uploads keep the local file URIs)
EXPO_PUBLIC_MOCK_STORAGE=
# ISBN lookup through the Google Books API, which needs no keys (empty = real)
EXPO_PUBLIC_MOCK_BOOK_LOOKUP=

# Keep mock data, including the signed-in mock account, across reloads (empty = true).
# false = start from the seed data on every launch.
EXPO_PUBLIC_MOCK_PERSIST=
